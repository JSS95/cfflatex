% \includecff, \cfftitle, and \cffauthor read the selected citation.
% \OMIT ... \TIMO hides lt3luabridge's engine-specific log lines.
\input{regression-test}
\documentclass{article}
\usepackage[T1]{fontenc}
\usepackage{cfflatex}
\begin{document}
\START
\TEST{default source is the top level}{
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cfftitle}
}
\TEST{source=preferred-citation}{
  \OMIT
  \includecff[source=preferred-citation]{paper.cff}
  \TIMO
  \TYPE{\cfftitle}
}
\TEST{top-level fields}{
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cfftitle}
  \TYPE{\cffauthor{1}{given-names} | \cffauthor{1}{family-names}}
  \TYPE{\cffauthor{1}{orcid}}
}
\TEST{top level without preferred-citation}{
  \OMIT
  \includecff{root-only.cff}
  \TIMO
  \TYPE{\cfftitle}
}
\TEST{absent author fields are empty}{
  \OMIT
  \includecff[source=preferred-citation]{mixed-authors.cff}
  \TIMO
  \TYPE{[\cffauthor{1}{family-names}] [\cffauthor{1}{given-names}]}
  \TYPE{[\cffauthor{2}{name}] [\cffauthor{2}{family-names}]}
  \TYPE{[\cffauthor{3}{given-names}] [\cffauthor{3}{orcid}]}
}
\TEST{each include replaces the previous metadata}{
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cfftitle: [\cffauthor{1}{orcid}]}
  \OMIT
  \includecff[source=preferred-citation]{paper.cff}
  \TIMO
  \TYPE{\cfftitle: [\cffauthor{1}{orcid}]}
}
\TEST{file in a subdirectory with a space}{
  \OMIT
  \includecff{data/citation file.cff}
  \TIMO
  \TYPE{\cfftitle}
}
\TEST{TeX special characters are escaped}{
  \OMIT
  \includecff{special.cff}
  \TIMO
  \TYPE{\cfftitle}
  \TYPE{\cffauthor{1}{name}}
}
\TEST{line breaks in values become spaces}{
  \OMIT
  \includecff{multiline.cff}
  \TIMO
  \TYPE{\cfftitle}
}
\TEST{abstract of the selected citation}{
  \OMIT
  \includecff[source=preferred-citation]{paper.cff}
  \TIMO
  \TYPE{\cffabstract}
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cffabstract}
}
\TEST{absent abstract is empty}{
  \OMIT
  \includecff{mixed-authors.cff}
  \TIMO
  \TYPE{[\cffabstract]}
}
\TEST{abstract is cleared by the next include}{
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{[\cffabstract]}
  \OMIT
  \includecff{mixed-authors.cff}
  \TIMO
  \TYPE{[\cffabstract]}
}
\TEST{line breaks in a literal-block abstract become spaces}{
  \OMIT
  \includecff{multiline.cff}
  \TIMO
  \TYPE{[\cffabstract]}
}
\TEST{source selects any top-level key}{
  \OMIT
  \includecff[source=x-thesis]{custom-key.cff}
  \TIMO
  \TYPE{\cfftitle}
  \TYPE{\cffauthor{1}{given-names} | \cffauthor{1}{family-names}}
  \TYPE{\cffabstract}
}
\TEST{author count of the selected citation}{
  \OMIT
  \includecff[source=preferred-citation]{paper.cff}
  \TIMO
  \TYPE{\cffauthorcount}
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cffauthorcount}
  \OMIT
  \includecff[source=preferred-citation]{mixed-authors.cff}
  \TIMO
  \TYPE{\cffauthorcount}
}
\TEST{author count in integer expressions}{
  \OMIT
  \includecff[source=preferred-citation]{mixed-authors.cff}
  \TIMO
  \TYPE{\the\numexpr \cffauthorcount + 1\relax}
  \TYPE{\ifnum \cffauthorcount > 1 several authors\else one author\fi}
  \TYPE{last: \cffauthor{\cffauthorcount}{given-names}}
}
\TEST{foreach author runs in order}{
  \OMIT
  \includecff[source=preferred-citation]{mixed-authors.cff}
  \TIMO
  \gdef\x{}
  \cffforeachauthor{\xdef\x{\x[\cffauthorindex]}}
  \TYPE{\x}
  \gdef\x{}
  \cffforeachauthor{%
    \xdef\x{\x\cffauthor{\cffauthorindex}{family-names}%
      \cffauthor{\cffauthorindex}{name};}}
  \TYPE{\x}
}
\TEST{foreach author survives groups that the code closes}{
  \OMIT
  \includecff[source=preferred-citation]{mixed-authors.cff}
  \TIMO
  \gdef\x{}
  \begingroup
  \cffforeachauthor{\endgroup\xdef\x{\x\cffauthorindex}\begingroup}
  \endgroup
  \TYPE{\x}
}
\TEST{nested foreach author}{
  \OMIT
  \includecff[source=preferred-citation]{paper.cff}
  \TIMO
  \gdef\x{}
  \cffforeachauthor{%
    \xdef\x{\x\cffauthorindex(}%
    \cffforeachauthor{\xdef\x{\x\cffauthorindex}}%
    \xdef\x{\x)\cffauthorindex;}}
  \TYPE{\x}
}
\TEST{affiliations}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \TYPE{\cffaffiliationcount: [\cffaffiliation{1}] [\cffaffiliation{2}]
    [\cffaffiliation{3}]}
  \TYPE{\cffauthoraffiliationcount{1} \cffauthoraffiliationcount{2}
    \cffauthoraffiliationcount{3} \cffauthoraffiliationcount{4}}
  \TYPE{[\cffauthoraffiliation{2}{1}] [\cffauthoraffiliation{2}{2}]
    [\cffauthoraffiliation{2}{3}]}
  \TYPE{[\cffauthor{2}{affiliation}]}
  \TYPE{\cffconvertaffiliationindex{1}{1};
    \cffconvertaffiliationindex{2}{1},\cffconvertaffiliationindex{2}{2},%
    \cffconvertaffiliationindex{2}{3}}
}
\TEST{affiliations are cleared by the next include}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \TYPE{\cffaffiliationcount}
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cffaffiliationcount}
}
\TEST{affiliations in foreach author}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \gdef\x{}
  \cffforeachauthor{%
    \xdef\x{\x\cffauthor{\cffauthorindex}{family-names}%
      \cffauthor{\cffauthorindex}{name}%
      (\cffauthoraffiliationcount{\cffauthorindex});}}
  \TYPE{\x}
}
\TEST{foreach affiliation}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \gdef\x{}
  \cffforeachaffiliation{%
    \xdef\x{\x[\cffaffiliationindex:\cffaffiliation{\cffaffiliationindex}]}}
  \TYPE{\x}
}
\TEST{foreach author affiliation}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \gdef\x{}
  \cffforeachauthoraffiliation{2}{%
    \xdef\x{\x[\cffauthoraffiliationindex:%
      \cffauthoraffiliation{2}{\cffauthoraffiliationindex}]}}
  \TYPE{\x}
  \gdef\x{}
  \cffforeachauthoraffiliation{3}{\xdef\x{\x never}}
  \TYPE{[\x]}
}
\TEST{foreach author affiliation in foreach author}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \gdef\x{}
  \cffforeachauthor{%
    \xdef\x{\x\cffauthorindex(}%
    \cffforeachauthoraffiliation{\cffauthorindex}{%
      \xdef\x{\x\ifnum\cffauthoraffiliationindex>1 ,\fi\cffauthoraffiliationindex}}%
    \xdef\x{\x)}}
  \TYPE{\x}
}
\TEST{affiliation loops survive groups and nest}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \gdef\x{}
  \begingroup
  \cffforeachaffiliation{\endgroup\xdef\x{\x\cffaffiliationindex}\begingroup}
  \endgroup
  \TYPE{\x}
  \gdef\x{}
  \cffforeachaffiliation{%
    \cffforeachauthoraffiliation{1}{}%
    \xdef\x{\x\cffaffiliationindex;}}
  \TYPE{\x}
}
\TEST{convert affiliation index in loops}{
  \OMIT
  \includecff{affiliations.cff}
  \TIMO
  \gdef\x{}
  \cffforeachauthor{%
    \xdef\x{\x\cffauthorindex(}%
    \cffforeachauthoraffiliation{\cffauthorindex}{%
      \xdef\x{\x\ifnum\cffauthoraffiliationindex>1 ,\fi
        \cffconvertaffiliationindex{\cffauthorindex}{\cffauthoraffiliationindex}}}%
    \xdef\x{\x)}}
  \TYPE{\x}
}
\TEST{contacts}{
  \OMIT
  \includecff{contacts.cff}
  \TIMO
  \TYPE{\cffcontactcount}
  \TYPE{\cffcontact{1}{given-names} | \cffcontact{1}{family-names}
    | \cffcontact{1}{email}}
  \TYPE{\cffcontact{2}{name} | \cffcontact{2}{email}
    | [\cffcontact{2}{given-names}]}
}
\TEST{contacts of the selected citation}{
  \OMIT
  \includecff[source=preferred-citation]{contacts.cff}
  \TIMO
  \TYPE{\cffcontactcount: \cffcontact{1}{family-names} \cffcontact{1}{email}}
  \OMIT
  \includecff{paper.cff}
  \TIMO
  \TYPE{\cffcontactcount}
  \gdef\x{}
  \cffforeachcontact{\xdef\x{\x never}}
  \TYPE{[\x]}
}
\TEST{foreach contact}{
  \OMIT
  \includecff{contacts.cff}
  \TIMO
  \gdef\x{}
  \cffforeachcontact{%
    \xdef\x{\x[\cffcontactindex:\cffcontact{\cffcontactindex}{family-names}%
      \cffcontact{\cffcontactindex}{name}]}}
  \TYPE{\x}
  \gdef\x{}
  \begingroup
  \cffforeachcontact{\endgroup\xdef\x{\x\cffcontactindex}\begingroup}
  \endgroup
  \TYPE{\x}
}
\END
