% Getters report misuse without stopping TeX.
\input{regression-test}
\documentclass{article}
\usepackage[T1]{fontenc}
\usepackage{import-citation-cff}
% These tests read several CFF files, which a document cannot: forget the
% loaded file before each \includecff.
\ExplSyntaxOn
\AddToHook { cmd/includecff/before } { \bool_gset_false:N \g__cfflatex_loaded_bool }
\ExplSyntaxOff
\begin{document}
\START
\TEST{\cffauthor before \includecff}{\TYPE{[\cffauthor{1}{given-names}]}}
\TEST{\cffforeachauthor before \includecff}{\cffforeachauthor{\TYPE{never}}}
\TEST{\cffaffiliationcount before \includecff}{\TYPE{[\cffaffiliationcount]}}
\TEST{\cffforeachaffiliation before \includecff}{\cffforeachaffiliation{\TYPE{never}}}
\TEST{\cffconvertaffiliationindex before \includecff}
  {\TYPE{[\cffconvertaffiliationindex{1}{1}]}}
\TEST{\cffcontact before \includecff}{\TYPE{[\cffcontact{1}{name}]}}
\TEST{\cffforeachcontact before \includecff}{\cffforeachcontact{\TYPE{never}}}
\TEST{\cff before \includecff}{\TYPE{[\cff{title}]}}
\TEST{\cffcount before \includecff}{\TYPE{[\cffcount{authors}]}}
\OMIT
\includecff{paper.cff}
\TIMO
\TEST{\cff of a sequence}{\TYPE{[\cff{authors}]}}
\TEST{\cff of a mapping}{\TYPE{[\cff{authors/1}]}}
\TEST{\cffcount of a value}{\TYPE{[\cffcount{title}]}}
\TEST{\cffcount of a mapping}{\TYPE{[\cffcount{authors/1}]}}
\TEST{contact index past the last contact}{\TYPE{[\cffcontact{1}{name}]}}
\TEST{\cffcontactindex outside \cffforeachcontact}{\TYPE{[\cffcontactindex]}}
\TEST{affiliation index of \cffconvertaffiliationindex}
  {\TYPE{[\cffconvertaffiliationindex{1}{1}]}}
\TEST{author index of \cffconvertaffiliationindex}
  {\TYPE{[\cffconvertaffiliationindex{2}{1}]}}
\TEST{\cffaffiliationindex outside an affiliation loop}{\TYPE{[\cffaffiliationindex]}}
\TEST{\cffauthoraffiliationindex outside an affiliation loop}
  {\TYPE{[\cffauthoraffiliationindex]}}
\TEST{author index of foreach author affiliation}
  {\cffforeachauthoraffiliation{2}{\TYPE{never}}}
\TEST{affiliation index past the last affiliation of an author}
  {\TYPE{[\cffauthoraffiliation{1}{1}]}}
\TEST{affiliation index past the last affiliation}{\TYPE{[\cffaffiliation{1}]}}
\TEST{author index of an affiliation count}{\TYPE{[\cffauthoraffiliationcount{2}]}}
\TEST{\cffauthorindex outside \cffforeachauthor}{\TYPE{[\cffauthorindex]}}
\TEST{author index 0}{\TYPE{[\cffauthor{0}{given-names}]}}
\TEST{author index past the last author}{\TYPE{[\cffauthor{3}{given-names}]}}
\OMIT
\includecff{affiliations.cff}
\TIMO
\TEST{\cffaffiliationindex in \cffforeachauthoraffiliation}
  {\cffforeachauthoraffiliation{2}{\TYPE{[\cffaffiliationindex]}}}
\TEST{\cffauthoraffiliationindex in \cffforeachaffiliation}
  {\cffforeachaffiliation{\TYPE{[\cffaffiliationindex:\cffauthoraffiliationindex]}}}
\END
