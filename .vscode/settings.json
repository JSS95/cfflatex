{
    // Build whenever a dependency of the document changes, not only when a
    // .tex file is saved, so that editing CITATION.cff rebuilds import-citation-cff.pdf.
    // LaTeX Workshop finds the CFF file in the .fls file of the last build.
    "latex-workshop.latex.autoBuild.run": "onFileChange",
    // l3build typesets the manual in build/doc/. If a copy there became the
    // root file, every file l3build copies would start a concurrent build,
    // which overwrites the .aux files and makes `l3build doc` and
    // `l3build ctan` fail.
    "latex-workshop.latex.search.rootFiles.exclude": ["build/**"],
    // The manual needs LuaLaTeX: the package runs its Lua code directly there
    // (pdfLaTeX would need shell escape), and the manual reads the help of
    // cfflatexpand with \directlua. latexmk also runs BibTeX for the
    // references and reruns LuaLaTeX until the cross-references settle.
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-lualatex",
            "command": "latexmk",
            "args": [
                "-lualatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (LuaLaTeX)",
            "tools": ["latexmk-lualatex"]
        }
    ]
}
