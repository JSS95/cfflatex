\ProvidesFile{cfflatex-style-authblk.def}[cffLaTeX authblk author style]
\ExplSyntaxOn

\cffdeclareauthorstyle { authblk }
  {
    requires = { authblk },
    prepare-author =
      {
        % authblk expands the first mark in an \if test. An empty group
        % prevents a leading footnote from executing in the preamble.
        \exp_args:NV \tl_if_head_eq_meaning:nNT \l__cfflatex_marks_tl
          \__cfflatex_thanks:n
          { \tl_put_left:Nn \l__cfflatex_marks_tl { {} } }
      },
    author = { \author [{#1}] {#2} },
    affiliation = { \affil [#1] {#2} },
  }

\ExplSyntaxOff
\endinput
