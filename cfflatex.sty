  {Import Citation File Format metadata into LaTeX}
\RequirePackage{lt3luabridge}

% check (default true): after \maketitle, warn unless \title used \cfftitle and
% \author used every author of the citation. See "Checking the title page".
\bool_new:N \g__cfflatex_check_bool
\keys_define:nn { cfflatex }
  {
    check .bool_gset:N = \g__cfflatex_check_bool,
    check .initial:n = true,
  }
\ProcessKeyOptions [cfflatex]

\msg_new:nnn { cfflatex } { missing-file } { CFF~file~'#1'~was~not~found. }
\msg_new:nnn { cfflatex } { missing-helper }
  { Install~cfflatex.lua~alongside~cfflatex.sty. }
\msg_new:nnn { cfflatex } { invalid } { Cannot~read~CFF~file:~#1. }
\msg_new:nnn { cfflatex } { not-loaded } { Call~\iow_char:N\\includecff~first. }
\msg_new:nnn { cfflatex } { author-index }
  { Author~index~'#1'~is~out~of~range. }
\msg_new:nnn { cfflatex } { affiliation-index }
  { Affiliation~'#1'~is~out~of~range. }
\msg_new:nnn { cfflatex } { contact-index } { Contact~'#1'~is~out~of~range. }
\msg_new:nnn { cfflatex } { not-in-contact-loop }
  { Not~inside~\iow_char:N\\cffforeachcontact. }
\msg_new:nnn { cfflatex } { not-in-loop }
  { Not~inside~\iow_char:N\\cffforeachauthor. }
\msg_new:nnn { cfflatex } { not-in-affiliation-loop }
  { Not~inside~an~affiliation~loop. }
\msg_new:nnn { cfflatex } { not-in-author-affiliation-loop }
  { Not~in~an~author~affiliation~loop. }
\msg_new:nnn { cfflatex } { title-unused }
  {
    \iow_char:N\\title~does~not~use~\iow_char:N\\cfftitle.~
    Load~cfflatex~with~check=false~to~skip~this~check.
  }
\msg_new:nnn { cfflatex } { authors-unused }
  {
    \iow_char:N\\author~does~not~use~author(s)~#1~of~the~citation.~
    Load~cfflatex~with~check=false~to~skip~this~check.
  }
\msg_new:nnn { cfflatex } { authblk-missing }
  { style=authblk~needs~the~authblk~package. }
\msg_new:nnn { cfflatex } { shell-escape }
  {
    pdfLaTeX~requires~unrestricted~shell~escape~to~read~CFF~files.~
    Compile~with~--shell-escape,~or~use~LuaLaTeX.
  }

\prop_new:N \g__cfflatex_values_prop
\int_new:N \g__cfflatex_author_count_int
% The index of the current author in \cffforeachauthor; 0 outside the loop.
\int_new:N \g__cfflatex_author_index_int
% The number of the current affiliation in \cffforeachaffiliation, and the
% index of the current affiliation of the author in
% \cffforeachauthoraffiliation; 0 outside these loops.
\int_new:N \g__cfflatex_affiliation_index_int
\int_new:N \g__cfflatex_author_affiliation_index_int
% The index of the current contact in \cffforeachcontact; 0 outside the loop.
\int_new:N \g__cfflatex_contact_index_int
\bool_new:N \g__cfflatex_loaded_bool
\tl_new:N \l__cfflatex_source_tl
\tl_new:N \l__cfflatex_filename_tl
\tl_new:N \g__cfflatex_helper_tl
\str_new:N \l__cfflatex_file_lua_str
\str_new:N \l__cfflatex_helper_lua_str
\str_new:N \l__cfflatex_source_lua_str
\ior_new:N \g__cfflatex_dependency_ior
% For the check: whether \maketitle is running, the part of the title page
% being typeset (1: \title, 2: \author, 0: neither), the uses recorded as
% "<part>/<use>" (use 0: \cfftitle, <i>: author <i>), and missing authors.
\bool_new:N \g__cfflatex_recording_bool
\tl_new:N \g__cfflatex_part_tl
\prop_new:N \g__cfflatex_used_prop
\clist_new:N \l__cfflatex_missing_clist
\cs_generate_variant:Nn \ior_open:Nn { NV }

% Prefer the helper next to this package so both files share a version.
\file_get_full_name:nNF { \@currpath cfflatex.lua } \g__cfflatex_helper_tl
  {
    \file_get_full_name:nNF { cfflatex.lua } \g__cfflatex_helper_tl
      { \msg_fatal:nn { cfflatex } { missing-helper } }
  }

\keys_define:nn { cfflatex / include }
  {
    source .tl_set:N = \l__cfflatex_source_tl,
    source .value_required:n = true,
  }

% Quote a file name or a source key as a Lua string literal; the file contents
% are parsed as YAML and never become Lua source.
\cs_new_protected:Npn \__cfflatex_lua_quote:NN #1#2
  {
    \str_set:Ne #2 { \tl_to_str:V #1 }
    \regex_replace_all:nnN { [\\"] } { \\\0 } #2
    \regex_replace_all:nnN { \r } { \\r } #2
    \regex_replace_all:nnN { \n } { \\n } #2
    \str_put_left:Nn #2 { " }
    \str_put_right:Nn #2 { " }
  }

% Called by the TeX code that cfflatex.lua returns; explcheck cannot see these
% uses, so it would report the functions as unused (W401).
\cs_new_protected:Npn \__cfflatex_store:nn #1#2 % noqa: w401
  { \prop_gput:Nnn \g__cfflatex_values_prop {#1} {#2} }
\cs_new_protected:Npn \__cfflatex_finish:n #1 % noqa: w401
  {
    \int_gset:Nn \g__cfflatex_author_count_int {#1}
    \bool_gset_true:N \g__cfflatex_loaded_bool
  }
\cs_new_protected:Npn \__cfflatex_fail:n #1 % noqa: w401
  { \msg_fatal:nnn { cfflatex } { invalid } {#1} }

% \includecff[source=<key>]{<file>}
% Reads the top level of <file>, or the mapping under its top-level <key>, such
% as preferred-citation. Each call replaces the previously loaded metadata.
\NewDocumentCommand \includecff {O{} m}
  {
    \group_begin:
    \tl_clear:N \l__cfflatex_source_tl
    \keys_set:nn { cfflatex / include } {#1}
    \file_get_full_name:nNF {#2} \l__cfflatex_filename_tl
      { \msg_fatal:nnn { cfflatex } { missing-file } {#2} }
    \sys_if_engine_luatex:F
      {
        \sys_if_shell_unrestricted:F
          { \msg_fatal:nn { cfflatex } { shell-escape } }
      }
    % cfflatex.lua reads the file outside TeX. Opening it once through TeX
    % lists it in the .fls file of the -recorder option, which latexmk and
    % LaTeX Workshop use to rebuild when a dependency changes. Finding the file
    % above does not always do so: LuaLaTeX with shell escape does not record
    % it.
    \ior_open:NV \g__cfflatex_dependency_ior \l__cfflatex_filename_tl
    \ior_close:N \g__cfflatex_dependency_ior
    \bool_gset_false:N \g__cfflatex_loaded_bool
    \int_gzero:N \g__cfflatex_author_count_int
    \prop_gclear:N \g__cfflatex_values_prop
    \__cfflatex_lua_quote:NN \l__cfflatex_filename_tl \l__cfflatex_file_lua_str
    \__cfflatex_lua_quote:NN \g__cfflatex_helper_tl \l__cfflatex_helper_lua_str
    \__cfflatex_lua_quote:NN \l__cfflatex_source_tl \l__cfflatex_source_lua_str
    \luabridge_now:e
      {
        local~kpse = require("kpse");
        local~helper = \exp_not:V \l__cfflatex_helper_lua_str;
        local~cfflatex = dofile(kpse.find_file(helper,~"tex")~or~helper);
        print(cfflatex.read(
        \exp_not:V \l__cfflatex_file_lua_str,
        \exp_not:V \l__cfflatex_source_lua_str
        ));
      }
    \group_end:
  }

% Checking the title page ----------------------------------------------------
%
% While \maketitle runs, \cfftitle and \cffauthor leave a record marker before
% their values, and markers around the contents of \@title and \@author tell
% which part of the title page is being typeset. The markers record when they
% are executed, which is when the title page is typeset; this sees uses in
% loops such as \cffforeachauthor and \foreach, whose indices are known only
% then. The markers carry only digits, so case changes such as \MakeUppercase
% keep them intact, and their names contain no "_" or ":", so they stay
% readable if a class writes the title page to a file.

% <use> is 0 for \cfftitle and <i> for author <i>.
\cs_new_protected:cpn { cfflatex@mark } #1
  {
    \bool_if:NT \g__cfflatex_recording_bool
      { \prop_gput:Nen \g__cfflatex_used_prop { \g__cfflatex_part_tl / #1 } {} }
  }
% <part> is 1 for \title, 2 for \author, and 0 after them.
\cs_new_protected:cpn { cfflatex@part } #1
  { \tl_gset:Nn \g__cfflatex_part_tl {#1} }
\cs_new:Npn \__cfflatex_mark:n #1
  {
    % The marker is protected, so it stays a marker in expansion contexts.
    \bool_if:NT \g__cfflatex_recording_bool
      { \use:c { cfflatex@mark } {#1} }
  }
\cs_generate_variant:Nn \__cfflatex_mark:n { e }
\cs_generate_variant:Nn \prop_gput:Nnn { Nen }

\cs_new_protected:Npn \__cfflatex_check_begin:
  {
    \bool_lazy_and:nnT { \g__cfflatex_check_bool } { \g__cfflatex_loaded_bool }
      {
        \prop_gclear:N \g__cfflatex_used_prop
        \tl_gset:Nn \g__cfflatex_part_tl { 0 }
        \__cfflatex_wrap_part:Nn \@title { 1 }
        \__cfflatex_wrap_part:Nn \@author { 2 }
        \bool_gset_true:N \g__cfflatex_recording_bool
      }
  }
\cs_new_protected:Npn \__cfflatex_wrap_part:Nn #1#2
  {
    \cs_gset:Npe #1
      {
        \exp_not:c { cfflatex@part } {#2}
        \exp_not:o {#1}
        \exp_not:c { cfflatex@part } { 0 }
      }
  }
\cs_new_protected:Npn \__cfflatex_check_end:
  {
    \bool_if:NT \g__cfflatex_recording_bool
      {
        \bool_gset_false:N \g__cfflatex_recording_bool
        \prop_if_in:NnF \g__cfflatex_used_prop { 1 / 0 }
          { \msg_warning:nn { cfflatex } { title-unused } }
        \clist_clear:N \l__cfflatex_missing_clist
        \int_step_inline:nn { \g__cfflatex_author_count_int }
          {
            \prop_if_in:NnF \g__cfflatex_used_prop { 2 / ##1 }
              { \clist_put_right:Nn \l__cfflatex_missing_clist {##1} }
          }
        \clist_if_empty:NF \l__cfflatex_missing_clist
          {
            \msg_warning:nne { cfflatex } { authors-unused }
              { \clist_use:Nn \l__cfflatex_missing_clist { ,~ } }
          }
      }
  }
\AddToHook {cmd/maketitle/before} [cfflatex] {\__cfflatex_check_begin:}
\AddToHook {cmd/maketitle/after} [cfflatex] {\__cfflatex_check_end:}
% hyperref drops the markers from PDF strings, such as bookmarks.
\AddToHook {begindocument} [cfflatex]
  {
    \cs_if_exist:NT \pdfstringdefDisableCommands
      {
        \pdfstringdefDisableCommands
          {
            \cs_set_eq:cN { cfflatex@mark } \use_none:n
            \cs_set_eq:cN { cfflatex@part } \use_none:n
          }
      }
  }

% Getters --------------------------------------------------------------------

% Expands to the value stored under the key #1, or to nothing if it is absent.
\cs_new:Npn \__cfflatex_value:n #1
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      { \prop_item:Nn \g__cfflatex_values_prop {#1} }
      { \msg_expandable_error:nn { cfflatex } { not-loaded } }
  }

% \cfftitle expands to the title of the loaded citation.
\NewExpandableDocumentCommand \cfftitle {}
  {
    \__cfflatex_mark:n { 0 }
    \__cfflatex_value:n { title }
  }

% \cffabstract expands to the abstract of the loaded citation, or to nothing if
% it has none.
\NewExpandableDocumentCommand \cffabstract {} {\__cfflatex_value:n { abstract }}

% \cffauthorcount expands to the number of authors of the loaded citation, so
% that it can be typeset or used in integer expressions.
\NewExpandableDocumentCommand \cffauthorcount {}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      { \int_use:N \g__cfflatex_author_count_int }
      { \msg_expandable_error:nn { cfflatex } { not-loaded } }
  }

% Expands to #2 if a CFF file is loaded and #1 is the index of an author, and
% reports an error otherwise.
\cs_new:Npn \__cfflatex_if_author:nT #1#2
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \bool_lazy_or:nnTF { \int_compare_p:nNn {#1} < { 1 } }
          { \int_compare_p:nNn {#1} > { \g__cfflatex_author_count_int } }
          { \msg_expandable_error:nnn { cfflatex } { author-index } {#1} }
          {#2}
      }
      { \msg_expandable_error:nn { cfflatex } { not-loaded } }
  }

% \cffauthor{<index>}{<field>} expands to a field of the <index>-th author,
% counting from 1. An absent field expands to nothing.
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\NewExpandableDocumentCommand \cffauthor {m m}
  {
    \__cfflatex_if_author:nT {#1}
      {
        \__cfflatex_mark:e { \int_eval:n {#1} }
        \prop_item:Ne \g__cfflatex_values_prop
          { authors / \int_eval:n {#1} / \tl_to_str:n {#2} }
      }
  }

% Affiliations ---------------------------------------------------------------
%
% cfflatex.lua splits each affiliation string at semicolons and numbers the
% distinct affiliations of the citation in the order they first appear.

% Expands to the number stored under the key #1, or to 0 if it is absent.
\prg_generate_conditional_variant:Nnn \prop_if_in:Nn { Ne } { TF }
\cs_new:Npn \__cfflatex_count:n #1
  {
    \prop_if_in:NeTF \g__cfflatex_values_prop {#1}
      { \prop_item:Ne \g__cfflatex_values_prop {#1} }
      { 0 }
  }
% Expands to #3 if #1 is between 1 and #2, and reports an error otherwise.
\cs_new:Npn \__cfflatex_if_affiliation:nnT #1#2#3
  {
    \bool_lazy_or:nnTF { \int_compare_p:nNn {#1} < { 1 } }
      { \int_compare_p:nNn {#1} > {#2} }
      { \msg_expandable_error:nnn { cfflatex } { affiliation-index } {#1} }
      {#3}
  }
% Expands to the item of author #1 under "affiliation-#3/#2".
\cs_new:Npn \__cfflatex_author_affiliation:nnn #1#2#3
  {
    \__cfflatex_if_author:nT {#1}
      {
        \__cfflatex_if_affiliation:nnT {#2}
          {
            \__cfflatex_count:n
              { authors / \int_eval:n {#1} / affiliation-count }
          }
          {
            \prop_item:Ne \g__cfflatex_values_prop
              {
                authors / \int_eval:n {#1} / affiliation- #3 / \int_eval:n {#2}
              }
          }
      }
  }

% \cffauthoraffiliationcount{<i>} expands to the number of affiliations of
% author <i>, which is 0 if the author has none.
\NewExpandableDocumentCommand \cffauthoraffiliationcount {m}
  {
    \__cfflatex_if_author:nT {#1}
      { \__cfflatex_count:n { authors / \int_eval:n {#1} / affiliation-count } }
  }

% \cffauthoraffiliation{<i>}{<k>} expands to the <k>-th affiliation of author
% <i>.
\NewExpandableDocumentCommand \cffauthoraffiliation {m m}
  {\__cfflatex_author_affiliation:nnn {#1} {#2} { names }}

% \cffconvertaffiliationindex{<i>}{<k>} expands to the number of the <k>-th
% affiliation of author <i> among the distinct affiliations of the citation,
% the index that \cffforeachaffiliation and \cffaffiliation use.
\NewExpandableDocumentCommand \cffconvertaffiliationindex {m m}
  {\__cfflatex_author_affiliation:nnn {#1} {#2} { indices }}

% \cffaffiliationcount expands to the number of distinct affiliations of the
% citation, and \cffaffiliation{<n>} to the <n>-th of them.
\NewExpandableDocumentCommand \cffaffiliationcount {}
  {\__cfflatex_value:n { affiliation-count }}
\NewExpandableDocumentCommand \cffaffiliation {m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \__cfflatex_if_affiliation:nnT {#1}
          { \__cfflatex_count:n { affiliation-count } }
          {
            \prop_item:Ne \g__cfflatex_values_prop
              { affiliations / \int_eval:n {#1} }
          }
      }
      { \msg_expandable_error:nn { cfflatex } { not-loaded } }
  }

% Contacts -------------------------------------------------------------------
%
% The contacts of the citation are optional; like the authors, each is a person
% or an entity.

% \cffcontactcount expands to the number of contacts of the citation, which is
% 0 if it has none.
\NewExpandableDocumentCommand \cffcontactcount {}
  {\__cfflatex_value:n { contact-count }}

% \cffcontact{<index>}{<field>} expands to a field of the <index>-th contact,
% counting from 1. An absent field expands to nothing.
\NewExpandableDocumentCommand \cffcontact {m m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \bool_lazy_or:nnTF { \int_compare_p:nNn {#1} < { 1 } }
          {
            \int_compare_p:nNn {#1} > { \__cfflatex_count:n { contact-count } }
          }
          { \msg_expandable_error:nnn { cfflatex } { contact-index } {#1} }
          {
            \prop_item:Ne \g__cfflatex_values_prop
              { contact / \int_eval:n {#1} / \tl_to_str:n {#2} }
          }
      }
      { \msg_expandable_error:nn { cfflatex } { not-loaded } }
  }

% Loops ----------------------------------------------------------------------
%
% \__cfflatex_loop:nnnnn {<first>} {<last>} {<set>} {<code>} {<restore>} runs
% <set>{<value>} and then <code> for each <value> from <first> to <last>, and
% then <restore>. The loops below keep their state in global variables, set by
% <set> and restored by <restore> to that of an enclosing loop, and in the
% arguments of this function. They add no group, so <code> may close and
% reopen groups, as \and does between the authors in \author.
\cs_new_protected:Npn \__cfflatex_loop:nnnnn #1#2#3#4#5
  {
    \int_compare:nNnTF {#1} > {#2}
      {#5}
      {
        #3 {#1}
        #4
        \exp_args:Nf \__cfflatex_loop:nnnnn { \int_eval:n { #1 + 1 } } {#2} {#3}
          {#4}
          {#5}
      }
  }

% \cffforeachauthor{<code>} runs <code> once for each author, in order, with
% \cffauthorindex expanding to the index of the author.
\NewDocumentCommand \cffforeachauthor {+m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \use:e
          {
            \__cfflatex_loop:nnnnn { 1 }
              { \int_use:N \g__cfflatex_author_count_int }
              { \int_gset:Nn \exp_not:N \g__cfflatex_author_index_int }
              { \exp_not:n {#1} }
              {
                \int_gset:Nn \exp_not:N \g__cfflatex_author_index_int
                  { \int_use:N \g__cfflatex_author_index_int }
              }
          }
      }
      { \msg_error:nn { cfflatex } { not-loaded } }
  }

% \cffauthorindex expands to the index of the current author in
% \cffforeachauthor.
\NewExpandableDocumentCommand \cffauthorindex {}
  {
    \int_compare:nNnTF { \g__cfflatex_author_index_int } = { 0 }
      { \msg_expandable_error:nn { cfflatex } { not-in-loop } }
      { \int_use:N \g__cfflatex_author_index_int }
  }

% \cffforeachaffiliation{<code>} runs <code> once for each distinct affiliation
% of the citation, in order, with \cffaffiliationindex expanding to the number
% of the affiliation.
\NewDocumentCommand \cffforeachaffiliation {+m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \use:e
          {
            \__cfflatex_loop:nnnnn { 1 }
              { \__cfflatex_count:n { affiliation-count } }
              { \int_gset:Nn \exp_not:N \g__cfflatex_affiliation_index_int }
              { \exp_not:n {#1} }
              {
                \int_gset:Nn \exp_not:N \g__cfflatex_affiliation_index_int
                  { \int_use:N \g__cfflatex_affiliation_index_int }
              }
          }
      }
      { \msg_error:nn { cfflatex } { not-loaded } }
  }

% \cffforeachauthoraffiliation{<index>}{<code>} runs <code> once for each
% affiliation of the <index>-th author, in order, with
% \cffauthoraffiliationindex expanding to the index of the affiliation among
% those of the author, counting from 1.
\NewDocumentCommand \cffforeachauthoraffiliation {m +m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \bool_lazy_or:nnTF { \int_compare_p:nNn {#1} < { 1 } }
          { \int_compare_p:nNn {#1} > { \g__cfflatex_author_count_int } }
          { \msg_error:nne { cfflatex } { author-index } { \int_eval:n {#1} } }
          {
            \exp_args:Ne \__cfflatex_foreach_author_affiliation:nn
              { \int_eval:n {#1} }
              {#2}
          }
      }
      { \msg_error:nn { cfflatex } { not-loaded } }
  }
% #1 is the index of the author, and #2 the code.
\cs_new_protected:Npn \__cfflatex_foreach_author_affiliation:nn #1#2
  {
    \use:e
      {
        \__cfflatex_loop:nnnnn { 1 }
          { \__cfflatex_count:n { authors / #1 / affiliation-count } }
          { \int_gset:Nn \exp_not:N \g__cfflatex_author_affiliation_index_int }
          { \exp_not:n {#2} }
          {
            \int_gset:Nn \exp_not:N \g__cfflatex_author_affiliation_index_int
              { \int_use:N \g__cfflatex_author_affiliation_index_int }
          }
      }
  }

% \cffaffiliationindex and \cffauthoraffiliationindex expand to the number of
% the current affiliation in \cffforeachaffiliation and to the index of the
% current affiliation of the author in \cffforeachauthoraffiliation.
% Expands to the value of the counter #1 if it is not 0, and to the code #2,
% an error, otherwise.
\cs_new:Npn \__cfflatex_loop_state:Nn #1#2
  {
    \int_compare:nNnTF {#1} = { 0 }
      {#2}
      { \int_use:N #1 }
  }
% \cffforeachcontact{<code>} runs <code> once for each contact of the citation,
% in order, with \cffcontactindex expanding to the index of the contact.
\NewDocumentCommand \cffforeachcontact {+m}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \use:e
          {
            \__cfflatex_loop:nnnnn { 1 }
              { \__cfflatex_count:n { contact-count } }
              { \int_gset:Nn \exp_not:N \g__cfflatex_contact_index_int }
              { \exp_not:n {#1} }
              {
                \int_gset:Nn \exp_not:N \g__cfflatex_contact_index_int
                  { \int_use:N \g__cfflatex_contact_index_int }
              }
          }
      }
      { \msg_error:nn { cfflatex } { not-loaded } }
  }

\NewExpandableDocumentCommand \cffaffiliationindex {}
  {
    \__cfflatex_loop_state:Nn \g__cfflatex_affiliation_index_int
      { \msg_expandable_error:nn { cfflatex } { not-in-affiliation-loop } }
  }
\NewExpandableDocumentCommand \cffauthoraffiliationindex {}
  {
    \__cfflatex_loop_state:Nn \g__cfflatex_author_affiliation_index_int
      {
        \msg_expandable_error:nn { cfflatex } { not-in-author-affiliation-loop }
      }
  }

% \cffcontactindex expands to the index of the current contact in
% \cffforeachcontact.
\NewExpandableDocumentCommand \cffcontactindex {}
  {
    \__cfflatex_loop_state:Nn \g__cfflatex_contact_index_int
      { \msg_expandable_error:nn { cfflatex } { not-in-contact-loop } }
  }

% Title page authors ---------------------------------------------------------
%
% \cffsetauthors[<keys>] declares the authors of the citation for \maketitle.
% Each author gets marks: the marks of their affiliations, numbered among the
% distinct affiliations of the citation, and a footnote for each contact of
% the citation with the same names. The keys give templates for the name, the
% footnote, and the commands that declare an author and an affiliation.

% Templates set by the keys; #1 of \__cfflatex_name:n and \__cfflatex_contact:n
% is a field getter, such as \cffauthor{2}, which takes a field.
\cs_new:Npn \__cfflatex_name:n #1 {}
\cs_new:Npn \__cfflatex_contact:n #1 {}
\cs_new:Npn \__cfflatex_affiliation_mark:n #1 {}
\cs_new_protected:Npn \__cfflatex_put_author:nn #1#2 {}
\cs_generate_variant:Nn \__cfflatex_put_author:nn { VV }
\cs_new_protected:Npn \__cfflatex_put_affiliation:nn #1#2 {}
\tl_new:N \l__cfflatex_separator_tl
\bool_new:N \l__cfflatex_affiliations_bool
\bool_new:N \l__cfflatex_contacts_bool
\bool_new:N \l__cfflatex_standard_bool
\bool_new:N \l__cfflatex_authblk_bool
\keys_define:nn { cfflatex / authors }
  {
    style .choice:,
    style / standard .code:n =
      {
        \bool_set_true:N \l__cfflatex_standard_bool
        \bool_set_false:N \l__cfflatex_authblk_bool
        \keys_set:nn { cfflatex / authors }
          {
            author = { \__cfflatex_standard_author:nn {##1} {##2} },
            affiliation = {},
          }
      },
    style / authblk .code:n =
      {
        \bool_set_false:N \l__cfflatex_standard_bool
        \bool_set_true:N \l__cfflatex_authblk_bool
        \keys_set:nn { cfflatex / authors }
          {
            author = { \author [{##1}] {##2} },
            affiliation = { \affil [##1] {##2} },
          }
      },
    name .code:n = { \cs_set:Npn \__cfflatex_name:n ##1 {#1} },
    contact .code:n =
      {
        \tl_if_blank:nTF {#1}
          { \bool_set_false:N \l__cfflatex_contacts_bool }
          {
            \bool_set_true:N \l__cfflatex_contacts_bool
            \cs_set:Npn \__cfflatex_contact:n ##1 {#1}
          }
      },
    separator .tl_set:N = \l__cfflatex_separator_tl,
    affiliation-mark .choice:,
    affiliation-mark / alph .code:n =
      { \cs_set_eq:NN \__cfflatex_affiliation_mark:n \int_to_alph:n },
    affiliation-mark / Alph .code:n =
      { \cs_set_eq:NN \__cfflatex_affiliation_mark:n \int_to_Alph:n },
    affiliation-mark / arabic .code:n =
      { \cs_set:Npn \__cfflatex_affiliation_mark:n ##1 { \int_eval:n {##1} } },
    affiliation-mark / roman .code:n =
      { \cs_set_eq:NN \__cfflatex_affiliation_mark:n \int_to_roman:n },
    affiliation-mark / Roman .code:n =
      { \cs_set_eq:NN \__cfflatex_affiliation_mark:n \int_to_Roman:n },
    author .code:n =
      { \cs_set_protected:Npn \__cfflatex_put_author:nn ##1##2 {#1} },
    affiliation .code:n =
      {
        \tl_if_blank:nTF {#1}
          { \bool_set_false:N \l__cfflatex_affiliations_bool }
          {
            \bool_set_true:N \l__cfflatex_affiliations_bool
            \cs_set_protected:Npn \__cfflatex_put_affiliation:nn ##1##2 {#1}
          }
      },
  }
% The defaults, set by each \cffsetauthors before its keys.
\tl_const:Nn \c__cfflatex_author_defaults_tl
  {
    style = standard,
    name = { #1 { given-names } \nobreakspace #1 { family-names } },
    contact = { E-mail:~#1 { email } },
    separator = { , },
    affiliation-mark = alph,
  }

% Like \thanks in \maketitle, but typesets the footnote symbol as text among
% the marks of an author, so that it does not overlap them.
\cs_new_protected:Npn \__cfflatex_thanks:n #1
  {
    \stepcounter {footnote}
    \protected@xdef \@thefnmark {\thefootnote}
    \@thefnmark
    \protected@xdef \@thanks
      {\@thanks \protect \footnotetext [\int_use:N \c@footnote] {#1}}
  }

% The style=standard author template collects the authors in one \author.
\tl_new:N \l__cfflatex_standard_authors_tl
\cs_new_protected:Npn \__cfflatex_standard_author:nn #1#2
  {
    \tl_if_empty:NF \l__cfflatex_standard_authors_tl
      { \tl_put_right:Nn \l__cfflatex_standard_authors_tl { \and } }
    \tl_put_right:Nn \l__cfflatex_standard_authors_tl {#2}
    \tl_if_blank:nF {#1}
      {
        \tl_put_right:Nn \l__cfflatex_standard_authors_tl
          { \textsuperscript {#1} }
      }
  }

% The names of the #2-th entry of the authors or the contacts #1, which
% identify a contact with an author.
\cs_new:Npn \__cfflatex_names:nn #1#2
  {
    \prop_item:Nn \g__cfflatex_values_prop { #1 / #2 / given-names } |
    \prop_item:Nn \g__cfflatex_values_prop { #1 / #2 / family-names } |
    \prop_item:Nn \g__cfflatex_values_prop { #1 / #2 / name }
  }

\tl_new:N \g__cfflatex_author_names_tl
\cs_generate_variant:Nn \seq_use:Nn { NV }
\seq_new:N \l__cfflatex_marks_seq
\seq_new:N \l__cfflatex_names_seq
\tl_new:N \l__cfflatex_marks_tl
\tl_new:N \l__cfflatex_name_tl
\tl_new:N \l__cfflatex_author_who_tl
\tl_new:N \l__cfflatex_contact_who_tl
\tl_new:N \l__cfflatex_contact_tl

\NewDocumentCommand \cffsetauthors {O{}}
  {
    \bool_if:NTF \g__cfflatex_loaded_bool
      {
        \keys_set:nV { cfflatex / authors } \c__cfflatex_author_defaults_tl
        \keys_set:nn { cfflatex / authors } {#1}
        \bool_lazy_and:nnTF { \l__cfflatex_authblk_bool }
          { ! \cs_if_exist_p:N \affil }
          { \msg_error:nn { cfflatex } { authblk-missing } }
          { \__cfflatex_set_authors: }
      }
      { \msg_error:nn { cfflatex } { not-loaded } }
  }
\cs_new_protected:Npn \__cfflatex_set_authors:
  {
    \tl_clear:N \l__cfflatex_standard_authors_tl
    \seq_clear:N \l__cfflatex_names_seq
    \int_step_inline:nn { \g__cfflatex_author_count_int }
      { \__cfflatex_set_author:n {##1} }
    \bool_if:NT \l__cfflatex_standard_bool
      { \exp_args:NV \author \l__cfflatex_standard_authors_tl }
    \bool_if:NT \l__cfflatex_affiliations_bool
      {
        \int_step_inline:nn { \__cfflatex_count:n { affiliation-count } }
          {
            \exp_args:Nee \__cfflatex_put_affiliation:nn
              { \__cfflatex_affiliation_mark:n {##1} }
              { \exp_not:N \cffaffiliation {##1} }
          }
      }
    \tl_gset:Ne \g__cfflatex_author_names_tl
      { \seq_use:Nn \l__cfflatex_names_seq { ,~ } }
  }
% Declares the #1-th author.
\cs_new_protected:Npn \__cfflatex_set_author:n #1
  {
    \seq_clear:N \l__cfflatex_marks_seq
    \bool_if:NT \l__cfflatex_affiliations_bool
      {
        \int_step_inline:nn
          { \__cfflatex_count:n { authors / #1 / affiliation-count } }
          {
            \seq_put_right:Ne \l__cfflatex_marks_seq
              {
                \__cfflatex_affiliation_mark:n
                  {
                    \prop_item:Nn \g__cfflatex_values_prop
                      { authors / #1 / affiliation-indices / ##1 }
                  }
              }
          }
      }
    \bool_if:NT \l__cfflatex_contacts_bool
      {
        \tl_set:Ne \l__cfflatex_author_who_tl
          { \__cfflatex_names:nn { authors } {#1} }
        \int_step_inline:nn { \__cfflatex_count:n { contact-count } }
          {
            \tl_set:Ne \l__cfflatex_contact_who_tl
              { \__cfflatex_names:nn { contact } {##1} }
            \tl_if_eq:NNT \l__cfflatex_author_who_tl \l__cfflatex_contact_who_tl
              {
                \tl_set:No \l__cfflatex_contact_tl
                  { \__cfflatex_contact:n { \cffcontact {##1} } }
                \seq_put_right:Ne \l__cfflatex_marks_seq
                  {
                    \exp_not:N \__cfflatex_thanks:n
                      { \exp_not:V \l__cfflatex_contact_tl }
                  }
              }
          }
      }
    \tl_set:Ne \l__cfflatex_marks_tl
      { \seq_use:NV \l__cfflatex_marks_seq \l__cfflatex_separator_tl }
    % \protect keeps \cffauthor for \maketitle, where the check sees it, when
    % the template expands the name, as the \author of authblk does.
    \tl_set:No \l__cfflatex_name_tl
      { \__cfflatex_name:n { \protect \cffauthor {#1} } }
    \__cfflatex_put_author:VV \l__cfflatex_marks_tl \l__cfflatex_name_tl
    \tl_set:No \l__cfflatex_name_tl { \__cfflatex_name:n { \cffauthor {#1} } }
    \seq_put_right:NV \l__cfflatex_names_seq \l__cfflatex_name_tl
  }

% \cffauthornames expands to the names of the authors, separated by commas, as
% the name template of \cffsetauthors makes them.
\NewExpandableDocumentCommand \cffauthornames {}
  {\tl_use:N \g__cfflatex_author_names_tl}

\endinput
