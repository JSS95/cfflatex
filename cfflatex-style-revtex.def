\ProvidesFile{cfflatex-style-revtex.def}
  [import-citation-cff REVTeX author style]
\ExplSyntaxOn

\cffdeclareauthorstyle { revtex }
  {
    contact = {},
    prepare-author = {},
    author =
      {
        \tl_if_blank:nTF {#1}
          { \author {#2} }
          { \author {#2\textsuperscript {#1}} }
      },
    affiliation = { \affiliation {#2} },
  }

\ExplSyntaxOff
\endinput
